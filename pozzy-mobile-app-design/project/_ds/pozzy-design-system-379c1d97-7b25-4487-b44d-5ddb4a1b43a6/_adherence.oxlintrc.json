{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/product/**",
              "components/shell/**",
              "ui_kits/pozzy/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist))/i]",
        "message": "Font not provided by the design system. Available: Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|name|label|key|ref|className|style|children)$/]",
        "message": "<AreaDot> doesn't accept that prop. Declared props: color, name, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|color|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, color, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|ok|warn|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'ok' | 'warn' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|block|type|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, block, type, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|proposal|onSubmit|onConfirm|onDiscard|key|ref|className|style|children)$/]",
        "message": "<CaptureBar> doesn't accept that prop. Declared props: placeholder, proposal, onSubmit, onConfirm, onDiscard."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|flush|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, meta, flush, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:email|active|onOpen|onHandled|key|ref|className|style|children)$/]",
        "message": "<EmailRow> doesn't accept that prop. Declared props: email, active, onOpen, onHandled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Empty'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|hint|action|compact|key|ref|className|style|children)$/]",
        "message": "<Empty> doesn't accept that prop. Declared props: icon, title, hint, action, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|inline|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, inline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|bold|fill|light|thin|duotone)$/]",
        "message": "<Icon> weight must be one of 'regular' | 'bold' | 'fill' | 'light' | 'thin' | 'duotone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|checked|onCheck|done|lead|trailing|first|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, checked, onCheck, done, lead, trailing, first, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|sticky|key|ref|className|style|children)$/]",
        "message": "<NavRail> doesn't accept that prop. Declared props: active, onNavigate, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|children|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, meta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|tone|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|ok|warn|auto)$/]",
        "message": "<ProgressBar> tone must be one of 'ink' | 'ok' | 'warn' | 'auto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: value, options, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|inline|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, onClose, inline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|height|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: lines, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:task|selected|onSelect|onComplete|key|ref|className|style|children)$/]",
        "message": "<TaskCard> doesn't accept that prop. Declared props: task, selected, onSelect, onComplete."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|fixed|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: text, tone, fixed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|danger)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:email|dark|onToggleTheme|onLogout|onMenu|showMenu|logoSrc|capture|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: email, dark, onToggleTheme, onLogout, onMenu, showMenu, logoSrc, capture."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackerChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|areaColor|met|some|count|target|onClick|key|ref|className|style|children)$/]",
        "message": "<TrackerChip> doesn't accept that prop. Declared props: name, areaColor, met, some, count, target, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|isCurrent|onPrev|onNext|onToday|key|ref|className|style|children)$/]",
        "message": "<WeekNav> doesn't accept that prop. Declared props: label, isCurrent, onPrev, onNext, onToday."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
